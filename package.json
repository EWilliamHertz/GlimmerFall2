{
  "name": "glimmerfall2",
  "version": "1.0.0",
  "description": "GlimmerFall Root Workspace",
  "scripts": {
    "dev:frontend": "cd frontend && PORT=3000 npm start",
    "dev:backend": "cd backend && python3 -m uvicorn server:app --reload --port 8000",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "install:all": "cd frontend && npm install --legacy-peer-deps && cd ../backend && pip install -r requirements.txt"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
